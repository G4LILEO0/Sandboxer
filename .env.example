# Copy to .env. Compose reads it for the variables passed through in compose.yaml; the
# API and worker also read it directly when run outside Docker.
SANDBOX_ENV=dev
SANDBOX_DATABASE_URL=postgresql+asyncpg://sandbox:sandbox@localhost:5432/sandbox
SANDBOX_AUTH_MODE=dev
# Wiped by the test suite; must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://sandbox:sandbox@localhost:5432/sandbox_test

# Required in prod: long random value, identical on every API instance.
# SANDBOX_SECRET_KEY=

# Optional: the IoC lookup page's enrichment, and per-analysis VirusTotal enrichment.
SANDBOX_VT_API_KEY=
SANDBOX_ABUSEIPDB_API_KEY=
# The URLhaus, ThreatFox and MalwareBazaar feeds need a free abuse.ch Auth-Key
# (https://auth.abuse.ch/). One key covers all three.
SANDBOX_ABUSECH_AUTH_KEY=

# Optional: Suricata over session pcaps, e.g. jasonish/suricata:7.0
# SANDBOX_SURICATA_IMAGE=
# Optional: gVisor for session containers where installed.
# SANDBOX_SESSION_RUNTIME=runsc

# OIDC single sign-on (SANDBOX_AUTH_MODE=oidc)
# SANDBOX_OIDC_ISSUER=https://login.example.com/realms/corp
# SANDBOX_OIDC_CLIENT_ID=url-sandbox
# SANDBOX_OIDC_CLIENT_SECRET=
# SANDBOX_OIDC_REDIRECT_URL=https://sandbox.example.com/auth/callback
# SANDBOX_OIDC_ROLES_CLAIM=roles
# SANDBOX_OIDC_ROLE_MAP={"sg-soc": "analyst", "sg-soc-leads": "senior_analyst", "sg-detection": "detection_engineer", "sg-sandbox-admins": "admin"}

# Bearer token for /metrics (required when SANDBOX_ENV=prod)
# SANDBOX_METRICS_TOKEN=

# Serve the live-view page from a local noVNC copy instead of the session container.
# SANDBOX_NOVNC_DIR=/usr/share/novnc

# --- Active-probe capture (needs legal sign-off, NFR-10; all OFF by default) ---------
# These make the browser session act like a victim. Review before enabling.
# Fill synthetic canary credentials and submit to trace exfil: off | automated | always.
# The canary mailbox must be one you control (it may then receive attacker mail).
# SANDBOX_CANARY_FILL=off
# Dispatch a DevTools/context-menu key probe to see what the page blocks.
# SANDBOX_KEY_PROBE=false
# Expose a fake, keyless window.ethereum wallet to observe crypto-drainer flows.
# SANDBOX_FAKE_WALLET=false
# Register service workers and record their script URLs (push-abuse detection). Default
# off keeps service workers blocked, which is safer.
# SANDBOX_ALLOW_SERVICE_WORKERS=false
