title: Credentials relayed over a WebSocket
severity: high
score: 50
tags: aitm, exfil
attack: T1557, T1056.003
description: A brand credential-prompt page opened a WebSocket, or a Socket.IO long-polling
  channel, to a host it does not own. AiTM kits (Mamba/Tycoon) use this real-time
  channel to relay typed credentials.
---
// A WebSocket or a Socket.IO long-polling channel to a host the page does not own ...
union
    (foreign_websockets | project channel = "websocket", host, url = substring(url, 0, 300), events),
    (foreign_socketio_polling | project channel = "socket.io polling", host, events)
// ... from a brand sign-in page or a Microsoft sign-in clone.
| where exists(brand_secret_page) or exists(ms_clone_pages)
