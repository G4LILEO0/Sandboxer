title: Password sent over plain HTTP
severity: low
score: 10
tags: insecure-form
description: A page serves a password form over plain http, or the form submits over plain
  http.
---
// A password form on a plain http: page, or one that posts to an http: target.
forms
| where has_password and not loose
| where page_url startswith "http:" or action_scheme == "http"
| project page_url, action
