title: Credential page on Google Apps Script
severity: medium
score: 25
tags: phishing, trusted-cloud
attack: T1583.006, T1566.002
description: A Google Apps Script web app (script.google.com/macros/s/.../exec) asks for a
  password, card or code, or posts what the visitor typed. Anyone can deploy one, so the
  Google host vouches for nothing.
---
// A page served by Google Apps Script ...
frames
| where (host == "script.google.com"
        and begins_with_match(url_path(url), list("microsoft.apps_script_exec")))
    or host == "script.googleusercontent.com"
    or host endswith "-script.googleusercontent.com"
    or host endswith ".script.googleusercontent.com"
// ... that asks for a password, card, code or phrase, or posts what is typed by script.
| where set_has(prompts, "password") or set_has(prompts, "payment")
    or set_has(prompts, "otp") or set_has(prompts, "seed")
    or script_posted
| distinct url
