title: Script posts credentials to another site
severity: high
score: 50
tags: phishing, credential-harvest
attack: T1056.003, T1041
description: A page with a password field and no real form action posted (fetch/XHR/beacon) to
  another site. Either the body carries a credential field, or the page is a brand
  credential prompt / Microsoft clone. This is the script-posted credential path that
  form-action rules miss.
---
capture
// A script posted a credential field to another site ...
| where signal("forms.script_posted_credentials") > 0
    // ... or a page with a password field and no real form action posted to another
    // site, and the page is a brand sign-in or a Microsoft sign-in clone.
    or (signal("forms.script_posts") > 0
        and (signal("brand.credential_prompt") == true or exists(ms_clone_pages)))
| project targets = signal("forms.script_posted_targets"), final_url = signal("final.url")
