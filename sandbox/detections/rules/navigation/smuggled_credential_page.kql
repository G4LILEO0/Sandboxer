title: Credential page built in the browser (HTML smuggling)
severity: high
score: 55
tags: phishing, smuggling
attack: T1027.006, T1566.002
description: A blob: or about: document created by the page carries a credential form: an
  HTML- smuggled phishing page assembled in the browser.
---
// A page that asks for a secret, served from a blob: or about: document the page's own
// script made (HTML smuggling).
frames
| where url startswith "blob:" or url startswith "about:srcdoc" or url startswith "about:blank"
| where isnotempty(prompt)
| distinct url
