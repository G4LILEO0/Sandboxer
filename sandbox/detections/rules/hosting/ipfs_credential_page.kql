title: Credential page on IPFS
severity: high
score: 45
tags: phishing
attack: T1566.002, T1583.006
description: The final page comes from an IPFS gateway and asks for credentials.
---
// The final page is served through an IPFS gateway ...
final_ipfs
// ... and asks for a password, a one-time code or a brand secret.
| where exists(password_pages) or exists(brand_secret_page) or exists(otp_pages)
| project final_url
