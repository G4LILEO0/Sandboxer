title: Tycoon 2FA phishing kit
severity: high
score: 55
tags: aitm, phaas, microsoft, google
attack: T1557, T1566.002, T1027, T1622
description: Tycoon 2FA traits together: a Microsoft or Google sign-in on a host the brand does not
  own, behind a CAPTCHA gate, with anti-analysis (DevTools or context menu blocked, a
  debugger trap, invisible-Unicode script) and one trait Salty2FA and generic kits lack:
  the kit's home-made canvas CAPTCHA, invisible-Unicode encoded script, or a real-time
  relay socket.
---
capture
// A Microsoft or Google sign-in clone ...
| where exists(ms_clone_pages)
    or (signal("brand.credential_prompt") == true
        and signal("brand.name") in ("Microsoft", "Google"))
// ... behind a CAPTCHA ...
| where signal("capture.gated") == true
// ... with anti-analysis: DevTools or the context menu blocked, a debugger trap, or
// invisible-character code ...
| where signal("evasion.devtools_blocked") > 0
    or signal("evasion.context_menu_blocked") == true
    or signal("evasion.debugger_trap") > 0
    or signal("scripts.invisible_unicode") > 0
// ... and Tycoon's plumbing: its own canvas CAPTCHA, invisible-character code, or a
// Socket.IO channel to a foreign host.
| where signal("capture.custom_captcha") > 0
    or signal("scripts.invisible_unicode") > 0
    or signal("websocket.foreign_count") > 0
    or signal("websocket.socketio_polling") > 0
| where signal("final.allowlisted") != true
| project brand = signal("brand.name"),
          custom_captcha_pages = signal("capture.custom_captcha_pages"),
          invisible_unicode = signal("scripts.invisible_unicode_details"),
          devtools_keys = signal("evasion.devtools_blocked_keys"),
          debugger_traps = signal("evasion.debugger_trap_sources"),
          final_url
