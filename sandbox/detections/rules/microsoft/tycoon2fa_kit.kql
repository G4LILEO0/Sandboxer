title: Tycoon 2FA phishing kit
severity: high
score: 55
tags: aitm, phaas, microsoft, google
attack: T1557, T1566.002, T1027, T1622
description: Tycoon 2FA traits together: a Microsoft or Google sign-in on a host the brand does not
  own, behind a CAPTCHA gate, with anti-analysis (DevTools or context menu blocked, a
  debugger trap, invisible-Unicode script) and one trait Salty2FA and generic kits lack:
  the kit's home-made canvas CAPTCHA, invisible-Unicode encoded script, or a real-time
  relay socket.
---
capture
// A Microsoft or Google sign-in clone ...
| where exists(ms_clone_pages)
    or toscalar(brand_secret_page | where brand in ("Microsoft", "Google") | count) > 0
// ... behind a CAPTCHA ...
| where exists(captcha_gates)
// ... with anti-analysis: DevTools or the context menu blocked, a debugger trap, or
// invisible-character code ...
| where exists(devtools_keys_blocked)
    or exists(context_menu_blocked)
    or exists(debugger_traps)
    or exists(invisible_code)
// ... and Tycoon's plumbing: its own canvas CAPTCHA, invisible-character code, or a
// relay channel to a foreign host.
| where exists(custom_captcha_pages)
    or exists(invisible_code)
    or exists(foreign_websockets)
    or exists(foreign_socketio_polling)
| where not(exists(final_allowlisted))
| project brand = toscalar(brand_claim | project brand),
          custom_captcha_pages = toscalar(custom_captcha_pages | summarize make_set(url)),
          invisible_code = toscalar(invisible_code | summarize make_set(source)),
          devtools_keys = toscalar(devtools_keys_blocked | summarize make_set(key)),
          debugger_traps = toscalar(debugger_traps | summarize make_set(source)),
          final_url
