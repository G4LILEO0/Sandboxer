title: Consent request for high-risk Microsoft Graph access
severity: high
score: 50
tags: consent-phishing, aitm
attack: T1528, T1566.002, T1550.001
description: An Entra authorize/consent request names a non-first-party client id and asks for
  high-risk Graph scopes (Mail.ReadWrite, Files.ReadWrite.All, offline_access).
---
// Entra authorize or admin-consent URLs anywhere in the redirect chain or the requests.
union chain_urls, (requests | project url)
| where url_host(url) in ("login.microsoftonline.com", "login.microsoft.com")
| where url_path(url) matches regex @"(?i)/(oauth2/(v2\.0/)?authorize|v2\.0/adminconsent|adminconsent)"
| extend prompt = tolower(url_param(url, "prompt")),
         client_id = tolower(url_param(url, "client_id")),
         scopes = split(replace_string(tolower(url_param(url, "scope")), "+", " "), " ")
// prompt=none is a silent sign-in, not a consent
| where prompt != "none"
// an app that is not one of Microsoft's own pre-consented apps
| where client_id !in list("microsoft.first_party_app_ids")
// asking for high-risk Graph scopes, and keeping them (offline_access) or forcing consent
| where set_has_any(scopes, list("microsoft.high_risk_scopes"))
| where set_has(scopes, "offline_access")
    or prompt == "consent"
    or tolower(url_path(url)) contains "adminconsent"
| project client_id, scopes, prompt, url = substring(url, 0, 300)
